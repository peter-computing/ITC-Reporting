<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish for IIS. Used by deploy\Publish.ps1, or in Visual Studio:
  right-click the project > Publish > IIS-Folder.
  Framework-dependent: the server needs the ASP.NET Core 8 Hosting Bundle.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>out\site\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>
  </PropertyGroup>
</Project>
