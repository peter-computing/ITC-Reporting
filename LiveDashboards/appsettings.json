{
  "ConnectionStrings": {
    "Finance":    "Server=localhost;Database=LiveDashboardMT_Finance;Trusted_Connection=True;TrustServerCertificate=True;ApplicationIntent=ReadOnly;",
    "Operations": "Server=localhost;Database=LiveDashboardMT_Ops;Trusted_Connection=True;TrustServerCertificate=True;ApplicationIntent=ReadOnly;"
  },

  "LiveDashboards": {
    "Title": "Live Dashboards",
    "PollMs": 30000,
    "MaxRows": 5000,

    "Rotation": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "PauseOnInteractionSeconds": 120
    },

    "Dashboards": [
      {
        "Id": "projects",
        "Title": "Project budgets",
        "MaxRows": 1000,
        "MaxRowsOrderBy": "Budget DESC",
        "Connection": "Finance",
        "Query": "SELECT Id, Name, Department, Owner, Status, Budget, Spent, DueDate, Notes, UpdatedAt FROM dbo.Projects",
        "ChangeQuery": "SELECT COUNT_BIG(*), CHECKSUM_AGG(BINARY_CHECKSUM(*)) FROM dbo.Projects",
        "CurrencyCode": "USD",

        "KeyField": "Id",
        "TitleField": "Name",
        "DefaultSort": "Budget",
        "DefaultSortDescending": true,

        "Fields": [
          { "Field": "Id",         "Label": "ID",           "Format": "number",    "Grid": true,  "Detail": true  },
          { "Field": "Name",       "Label": "Project",      "Format": "text",      "Grid": true,  "Detail": false },
          { "Field": "Department", "Label": "Department",   "Format": "text",      "Grid": true,  "Detail": true  },
          { "Field": "Status",     "Label": "Status",       "Format": "status",    "Grid": true,  "Detail": true  },
          { "Field": "Budget",     "Label": "Budget",       "Format": "currency",  "Grid": true,  "Detail": true  },
          { "Field": "Spent",      "Label": "Spent",        "Format": "currency",  "Grid": true,  "Detail": true  },
          { "Field": "DueDate",    "Label": "Due",          "Format": "date",      "Grid": false, "Detail": true  },
          { "Field": "Owner",      "Label": "Owner",        "Format": "text",      "Grid": false, "Detail": true  },
          { "Field": "Notes",      "Label": "Notes",        "Format": "multiline", "Grid": false, "Detail": true  },
          { "Field": "UpdatedAt",  "Label": "Last updated", "Format": "datetime",  "Grid": false, "Detail": true  }
        ],

        "Summary": [
          { "Label": "Projects",     "Agg": "count" },
          { "Label": "Total budget", "Agg": "sum",   "Field": "Budget", "Format": "currency" },
          { "Label": "Total spent",  "Agg": "sum",   "Field": "Spent",  "Format": "currency" },
          { "Label": "On track",     "Agg": "count", "Field": "Status", "Match": "on_track" },
          { "Label": "At risk",      "Agg": "count", "Field": "Status", "Match": "at_risk" },
          { "Label": "Over budget",  "Agg": "count", "Field": "Status", "Match": "over_budget" }
        ],

        "Group": { "Field": "Department", "ValueField": "Budget" },

        "Statuses": {
          "on_track":    { "Label": "On track",    "Color": "green"  },
          "at_risk":     { "Label": "At risk",     "Color": "yellow" },
          "over_budget": { "Label": "Over budget", "Color": "red"    },
          "closed":      { "Label": "Closed",      "Color": "gray"   },
          "*":           {                         "Color": "gray"   }
        }
      },

      {
        "Id": "tasks",
        "Title": "Task status",
        "MaxRowsOrderBy": "DueDate",
        "Connection": "Operations",
        "Query": "SELECT Id, Name, Category, Owner, Location, Priority, Status, DueDate, Notes, UpdatedAt FROM dbo.Tasks",
        "ChangeQuery": "SELECT COUNT_BIG(*), CHECKSUM_AGG(BINARY_CHECKSUM(*)) FROM dbo.Tasks",

        "KeyField": "Id",
        "TitleField": "Name",
        "DefaultSort": "DueDate",

        "Fields": [
          { "Field": "Id",        "Label": "ID",           "Format": "number",    "Grid": true,  "Detail": true  },
          { "Field": "Name",      "Label": "Task",         "Format": "text",      "Grid": true,  "Detail": false },
          { "Field": "Category",  "Label": "Category",     "Format": "text",      "Grid": true,  "Detail": true  },
          { "Field": "Priority",  "Label": "Priority",     "Format": "text",      "Grid": true,  "Detail": true  },
          { "Field": "Status",    "Label": "Status",       "Format": "status",    "Grid": true,  "Detail": true  },
          { "Field": "DueDate",   "Label": "Due",          "Format": "date",      "Grid": true,  "Detail": true  },
          { "Field": "Owner",     "Label": "Owner",        "Format": "text",      "Grid": false, "Detail": true  },
          { "Field": "Location",  "Label": "Location",     "Format": "text",      "Grid": false, "Detail": true  },
          { "Field": "Notes",     "Label": "Notes",        "Format": "multiline", "Grid": false, "Detail": true  },
          { "Field": "UpdatedAt", "Label": "Last updated", "Format": "datetime",  "Grid": false, "Detail": true  }
        ],

        "Summary": [
          { "Label": "Tasks",         "Agg": "count" },
          { "Label": "Open",          "Agg": "count", "Field": "Status",   "Match": "open" },
          { "Label": "In progress",   "Agg": "count", "Field": "Status",   "Match": "in_progress" },
          { "Label": "Blocked",       "Agg": "count", "Field": "Status",   "Match": "blocked" },
          { "Label": "Done",          "Agg": "count", "Field": "Status",   "Match": "done" },
          { "Label": "High priority", "Agg": "count", "Field": "Priority", "Match": "High" }
        ],

        "Group": { "Field": "Category" },

        "Statuses": {
          "open":        { "Label": "Open",        "Color": "gray"   },
          "in_progress": { "Label": "In progress", "Color": "yellow" },
          "blocked":     { "Label": "Blocked",     "Color": "red"    },
          "done":        { "Label": "Done",        "Color": "green"  },
          "*":           {                         "Color": "gray"   }
        }
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
